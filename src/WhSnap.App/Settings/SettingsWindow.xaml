<!--
  WhSnap · 设置界面（Focal 设计语言 v1.0 落地）
  ===========================================================================
  对应视觉稿：design/focal/surfaces/settings.html（980×680 固定画布）。
  WPF 侧窗口尺寸可以不同，但密度 / 度量 / 圆角 / 层级 / 颜色关系必须一致：
    * 窗口底 obsidian-900，标题栏 32（Focal.TitleBar），左导航 188（Focal.Rail，
      11 个分组一次摊开），内容区可滚动，底部操作条 56，内容区底部状态条 28；
    * 设置行固定三段式：标题 14/400 + 一句人话 12/400 + 右侧控件；
    * 界面代码里不出现任何字面量色值：一律 {StaticResource Focal.*}。
  分组行与热键行由 SettingsWindow.xaml.cs 按 SettingsSchema / HotkeyCatalog 生成
  （schema 是唯一数据源，界面不允许漏项）。
-->
<Window x:Class="WhSnap.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:WhSnap.Theme"
        Title="WhSnap 设置"
        Width="980" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Focal.Obsidian900Brush}"
        Foreground="{StaticResource Focal.OnDarkBrush}"
        FontFamily="{StaticResource Focal.TextFont}"
        FontSize="{StaticResource Focal.BodySize}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 按钮里的文字：跟随按钮自身的前景色（主按钮翻墨字、安静按钮降一档、危险按钮走语义色），
             既不写死颜色，也不落在 BodyText 的 on-dark 上。 -->
        <Style x:Key="Focal.ButtonCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="Focal.ButtonCaptionSmall" TargetType="TextBlock" BasedOn="{StaticResource Focal.ButtonCaption}">
            <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
        </Style>

        <!-- 小号安静按钮（横幅动作）：quiet 的克制 + small 的密度 -->
        <Style x:Key="Focal.Button.SmallQuiet" TargetType="Button" BasedOn="{StaticResource Focal.Button.Quiet}">
            <Setter Property="Height" Value="{StaticResource Focal.ControlHeightSmall}"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ 标题栏 32：图标（琥珀）+ 标题 + 窗口按钮 ═══════════ -->
        <!-- WindowStyle=None：拖动标题栏空白处移动窗口；按钮自己处理鼠标左键，不会触发拖动。 -->
        <Border Grid.Row="0"
                Style="{StaticResource Focal.TitleBar}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <theme:FocalIcon x:Name="TitleBarIcon" Grid.Column="0"
                                 Icon="gear" Size="{StaticResource Focal.IconMd}"
                                 Foreground="{StaticResource Focal.AccentBrush}"
                                 VerticalAlignment="Center" Margin="12,0,8,0"/>

                <TextBlock Grid.Column="1" Text="WhSnap 设置"
                           Style="{StaticResource Focal.TitleBarText}"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource Focal.WindowButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化"
                            AutomationProperties.Name="最小化">
                        <Rectangle Width="10" Height="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource Focal.WindowButtonClose}"
                            Click="Close_Click"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭">
                        <theme:FocalIcon x:Name="CloseButtonIcon" Icon="x" Size="{StaticResource Focal.IconSm}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 主体：左导航 188 +（可滚动内容区 + 状态条） ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：全部 11 个分组一次摊开（设置不该需要「猜在哪一页」） -->
            <Border Grid.Column="0" Style="{StaticResource Focal.Rail}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="RailItems" Grid.Row="0"
                                  Margin="0,12,0,0"
                                  Focusable="False"
                                  AutomationProperties.Name="设置分组导航">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" Margin="16,4,16,12">
                        <TextBlock Text="所有改动即时生效并写入"
                                   Style="{StaticResource Focal.CaptionText}"/>
                        <TextBlock Text="%APPDATA%\WhSnap"
                                   Style="{StaticResource Focal.DataText}"
                                   FontSize="{StaticResource Focal.MicroSize}"
                                   Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,12,20,16"
                              Focusable="False">
                    <StackPanel>
                        <!-- 状态面：配置载入状态 / 错误 / 热键冲突（语义色只活在这里） -->
                        <StackPanel x:Name="BannerHost">

                            <Border x:Name="StatusBanner"
                                    Style="{StaticResource Focal.BannerOk}"
                                    Margin="0,0,0,12"
                                    AutomationProperties.Name="配置状态">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <theme:FocalIcon x:Name="StatusBannerIcon" Grid.Column="0"
                                                     Icon="check" Size="{StaticResource Focal.IconMd}"
                                                     Foreground="{StaticResource Focal.SignalOkBrush}"
                                                     VerticalAlignment="Top" Margin="0,1,8,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="StatusBannerTitle"
                                                   Style="{StaticResource Focal.BodyStrongText}"
                                                   Text="配置已载入"/>
                                        <TextBlock x:Name="BannerText"
                                                   Style="{StaticResource Focal.CaptionText}"
                                                   Margin="0,2,0,0"
                                                   Text="正在载入配置…"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="ErrorBanner"
                                    Style="{StaticResource Focal.BannerDanger}"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="错误">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <theme:FocalIcon x:Name="ErrorBannerIcon" Grid.Column="0"
                                                     Icon="warning" Size="{StaticResource Focal.IconMd}"
                                                     Foreground="{StaticResource Focal.SignalDangerBrush}"
                                                     VerticalAlignment="Top" Margin="0,1,8,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ErrorBannerTitle"
                                                   Style="{StaticResource Focal.BodyStrongText}"
                                                   Text="出错了"/>
                                        <TextBlock x:Name="ErrorBannerText"
                                                   Style="{StaticResource Focal.CaptionText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource Focal.Button.SmallQuiet}"
                                            Click="DismissError_Click"
                                            Margin="8,0,0,0" VerticalAlignment="Top"
                                            ToolTip="关掉这条提示"
                                            AutomationProperties.Name="忽略错误">
                                        <TextBlock Text="忽略" Style="{StaticResource Focal.ButtonCaptionSmall}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="HotkeyBanner"
                                    Style="{StaticResource Focal.BannerWarn}"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="热键冲突">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <theme:FocalIcon x:Name="HotkeyBannerIcon" Grid.Column="0"
                                                     Icon="warning" Size="{StaticResource Focal.IconMd}"
                                                     Foreground="{StaticResource Focal.SignalWarnBrush}"
                                                     VerticalAlignment="Top" Margin="0,1,8,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="HotkeyBannerTitle"
                                                   Style="{StaticResource Focal.BodyStrongText}"
                                                   Text="热键冲突"/>
                                        <TextBlock x:Name="HotkeyBannerText"
                                                   Style="{StaticResource Focal.CaptionText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Style="{StaticResource Focal.Button.Small}"
                                                Click="FixConflict_Click"
                                                ToolTip="跳到快捷键分组，直接重录冲突的那个键位"
                                                AutomationProperties.Name="换一个键位">
                                            <TextBlock Text="换一个键位" Style="{StaticResource Focal.ButtonCaptionSmall}"/>
                                        </Button>
                                        <Button Style="{StaticResource Focal.Button.SmallQuiet}"
                                                Click="DismissHotkeyBanner_Click"
                                                Margin="8,0,0,0"
                                                ToolTip="先不管（下次改键位时会再出现）"
                                                AutomationProperties.Name="忽略冲突提示">
                                            <TextBlock Text="忽略" Style="{StaticResource Focal.ButtonCaptionSmall}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 11 个分组（9 配置分组 + 快捷键 + 维护）由代码按 schema 追加 -->
                        <StackPanel x:Name="ContentHost"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 状态条 28：结论 + 配置路径（数字/路径走等宽） -->
                <Border Grid.Row="1" Style="{StaticResource Focal.StatusBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="StatusDot" Grid.Column="0"
                                 Style="{StaticResource Focal.StatusDot}"
                                 VerticalAlignment="Center" Margin="12,0,8,0"/>

                        <TextBlock x:Name="StatusText" Grid.Column="1"
                                   Style="{StaticResource Focal.CaptionText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Text="正在载入配置…"/>

                        <TextBlock x:Name="StatusPath" Grid.Column="2"
                                   Style="{StaticResource Focal.DataText}"
                                   FontSize="{StaticResource Focal.MicroSize}"
                                   Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ 底部操作条 56 ═══════════ -->
        <Border Grid.Row="2" Height="{StaticResource Focal.Space5xl}"
                Background="{StaticResource Focal.VoidBrush}"
                BorderBrush="{StaticResource Focal.HairlineDarkBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Focal.Button.Secondary}"
                        Click="ProbeHotkeys_Click"
                        ToolTip="放开自己的热键后逐个试注册，判定是否已被别的软件占用"
                        AutomationProperties.Name="检测热键占用">
                    <StackPanel Orientation="Horizontal">
                        <theme:FocalIcon x:Name="ProbeIcon" Icon="keyboard" Size="{StaticResource Focal.IconMd}"/>
                        <TextBlock Text="检测热键占用" Style="{StaticResource Focal.ButtonCaption}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource Focal.Button.Quiet}"
                        Click="Export_Click"
                        ToolTip="把全部配置导出成一份 JSON"
                        AutomationProperties.Name="导出配置">
                    <StackPanel Orientation="Horizontal">
                        <theme:FocalIcon x:Name="ExportIcon" Icon="upload" Size="{StaticResource Focal.IconMd}"/>
                        <TextBlock Text="导出配置…" Style="{StaticResource Focal.ButtonCaption}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource Focal.Button.Quiet}"
                        Click="Import_Click"
                        Margin="8,0,0,0"
                        ToolTip="从 JSON 导入配置；未知项与非法值会被拒绝并逐项报告"
                        AutomationProperties.Name="导入配置">
                    <StackPanel Orientation="Horizontal">
                        <theme:FocalIcon x:Name="ImportIcon" Icon="download" Size="{StaticResource Focal.IconMd}"/>
                        <TextBlock Text="导入配置…" Style="{StaticResource Focal.ButtonCaption}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource Focal.Button.Danger}"
                        Click="ResetDefaults_Click"
                        Margin="8,0,0,0"
                        ToolTip="把全部设置与热键恢复为出厂默认"
                        AutomationProperties.Name="恢复默认">
                    <TextBlock Text="恢复默认" Style="{StaticResource Focal.ButtonCaption}"/>
                </Button>

                <Button Grid.Column="5" Style="{StaticResource Focal.Button.Primary}"
                        Click="Close_Click"
                        Margin="8,0,0,0"
                        ToolTip="关闭设置（改动已经即时生效并落盘）"
                        AutomationProperties.Name="完成并关闭">
                    <StackPanel Orientation="Horizontal">
                        <theme:FocalIcon Icon="check" Size="{StaticResource Focal.IconMd}"/>
                        <TextBlock Text="完成" Style="{StaticResource Focal.ButtonCaption}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="WhSnap.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhSnap 设置"
        Width="820" Height="660"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F2" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BannerBorder"
                Grid.Row="0"
                Background="#FF232323"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,7"
                Margin="0,0,0,10">
            <TextBlock x:Name="BannerText" Text="正在载入配置…" />
        </Border>

        <TabControl x:Name="Tabs"
                    Grid.Row="1"
                    Background="#FF141414"
                    BorderBrush="#33FFFFFF" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="检测热键占用" Click="ProbeHotkeys_Click" />
            <Button Content="导出配置…" Click="Export_Click" />
            <Button Content="导入配置…" Click="Import_Click" />
            <Button Content="恢复默认" Click="ResetDefaults_Click" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>

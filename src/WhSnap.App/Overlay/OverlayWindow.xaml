<Window x:Class="WhSnap.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhSnap 截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        Background="#FF0B0B0B"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- 冻结的屏幕内容：按物理像素 1:1 呈现，绝不做插值缩放 -->
        <Image x:Name="FrozenImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased" />

        <!-- 暗化层与选区边框由代码动态加入 -->
        <Canvas x:Name="Layer" ClipToBounds="True" />

        <!-- 尺寸/坐标提示：必须是 Canvas 的直接子元素，Canvas.SetLeft 才生效 -->
        <Canvas x:Name="HudLayer" ClipToBounds="True" IsHitTestVisible="False">
            <Border x:Name="HudBorder"
                    Background="#E61B1B1B"
                    BorderBrush="#553B9CFF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="7,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="HudText"
                           Foreground="#FFF2F2F2"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           FontSize="12" />
            </Border>
        </Canvas>

        <!-- 操作提示 -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#CC1B1B1B"
                BorderBrush="#443B9CFF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,6"
                IsHitTestVisible="False">
            <TextBlock Foreground="#FFDCDCDC"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       Text="拖动选择区域　·　Enter 复制并保存　·　Esc 或右键取消" />
        </Border>

    </Grid>
</Window>

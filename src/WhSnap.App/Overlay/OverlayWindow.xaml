<Window x:Class="WhSnap.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhSnap 截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        Background="#FF0B0B0B"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent">

        <!-- 本显示器那一块冻结画面：按物理像素 1:1 呈现 -->
        <Image x:Name="FrozenImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased" />

        <!-- 暗化层、选区边框、8 向手柄（代码构建） -->
        <Canvas x:Name="Layer" ClipToBounds="True" />

        <!-- HUD：放大镜 + 尺寸 + 色值 -->
        <Canvas x:Name="HudLayer" ClipToBounds="True" IsHitTestVisible="False">

            <!-- 元素检测：光标下的界面元素高亮框 -->
            <Border x:Name="ElementBorder"
                    Visibility="Collapsed"
                    BorderBrush="#FF35C7FF"
                    BorderThickness="2"
                    Background="#2035C7FF"
                    CornerRadius="2">
                <Border x:Name="ElementLabelBorder"
                        Background="#E61B1B1B"
                        CornerRadius="3"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="ElementLabel"
                               Foreground="#FFF2F2F2"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="11" />
                </Border>
            </Border>

            <!-- 颜色历史（取色器） -->
            <Border x:Name="ColorHistoryPanel"
                    Visibility="Collapsed"
                    Background="#CC1B1B1B"
                    BorderBrush="#553B9CFF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,4">
                <StackPanel x:Name="ColorHistoryStrip" Orientation="Horizontal" />
            </Border>

            <Border x:Name="MagnifierPanel"
                    Visibility="Collapsed"
                    Background="#FF0E0E0E"
                    BorderBrush="#803B9CFF"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid x:Name="MagnifierRoot">
                    <Image x:Name="MagnifierImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           RenderOptions.EdgeMode="Aliased" />
                    <Canvas x:Name="MagnifierGrid" ClipToBounds="True" />
                    <Rectangle x:Name="MagnifierCenter"
                               Stroke="#FFFFD34D"
                               StrokeThickness="1"
                               Fill="#26FFD34D"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border x:Name="HudBorder"
                    Visibility="Collapsed"
                    Background="#E61B1B1B"
                    BorderBrush="#553B9CFF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="7,3">
                <TextBlock x:Name="HudText"
                           Foreground="#FFF2F2F2"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           FontSize="12" />
            </Border>

            <Border x:Name="ColorBorder"
                    Visibility="Collapsed"
                    Background="#E61B1B1B"
                    BorderBrush="#553B9CFF"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="7,3">
                <TextBlock x:Name="ColorText"
                           Foreground="#FFF2F2F2"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           FontSize="12" />
            </Border>
        </Canvas>

        <!-- 操作提示 -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#CC1B1B1B"
                BorderBrush="#443B9CFF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,6"
                IsHitTestVisible="False">
            <TextBlock Foreground="#FFDCDCDC"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       Text="拖动框选　·　单击选中高亮元素　·　Tab 切元素　·　方向键微调　·　Ctrl+方向键改边界　·　T 标注　·　C 取色　·　Enter 确认　·　F3 贴图　·　Esc 取消" />
        </Border>

    </Grid>
</Window>

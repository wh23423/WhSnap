<Window x:Class="WhSnap.Pin.PinPanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhSnap 贴图管理"
        Width="560" Height="440"
        MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText"
                       Foreground="#FFF2F2F2"
                       VerticalAlignment="Center"
                       Text="当前没有贴图。" />
            <Button x:Name="RefreshButton"
                    Content="刷新"
                    Margin="12,0,0,0"
                    Padding="10,3"
                    Click="Refresh_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FF141414" BorderBrush="#33FFFFFF" BorderThickness="1">
            <ItemsControl x:Name="PinList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFF2F2F2" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#FF9A9A9A" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="置顶" Tag="{Binding}" Click="PinToFront_Click" Padding="8,2" Margin="4,0,0,0" />
                                    <Button Content="{Binding ToggleText}" Tag="{Binding}" Click="PinToggleHidden_Click" Padding="8,2" Margin="4,0,0,0" />
                                    <Button Content="关闭" Tag="{Binding}" Click="PinClose_Click" Padding="8,2" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="显示全部" Click="ShowAll_Click" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="隐藏全部" Click="HideAll_Click" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="全部置顶" Click="BringAll_Click" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="关闭全部" Click="CloseAll_Click" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="关闭窗口" Click="CloseWindow_Click" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="WhSnap.Pin.PinPanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:WhSnap.Theme"
        Title="贴图管理"
        Width="796" Height="596"
        MinWidth="656" MinHeight="436"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Focal.TextFont}"
        FontSize="{StaticResource Focal.BodySize}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
      贴图管理面板 —— design/focal/surfaces/pin-panel.html 的 WPF 落地。
        机壳 obsidian-900 / 标题栏 32 / 行高 40（双行）/ 缩略块 44×34 / 圆角 6·10·14。
      结构：标题栏 → 概要行 → 列头 → 列表（悬停才出操作）→ 空状态 → 批量条 → 状态栏。
      颜色 · 圆角 · 度量 · 字号全部走 Focal 令牌，界面代码里不出现字面量色值。
    -->

    <Window.Resources>
        <!-- 列表行：Focal.ListItem + 单张操作「悬停或选中才出现」（降低常态噪声） -->
        <Style x:Key="PinPanelRow" TargetType="ListBoxItem" BasedOn="{StaticResource Focal.ListItem}">
            <Setter Property="MinHeight" Value="{StaticResource Focal.RowHeightLarge}" />
        </Style>

        <!-- 批量条里的小号主操作：琥珀填充 + 墨字，高度对齐同一行的小按钮（26） -->
        <Style x:Key="PinPanelPrimarySmall" TargetType="Button" BasedOn="{StaticResource Focal.Button.Primary}">
            <Setter Property="Height" Value="{StaticResource Focal.ControlHeightSmall}" />
            <Setter Property="Padding" Value="12,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- L1 机壳：面板浮在不可控桌面内容之上 -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{StaticResource Focal.VoidBrush}"
                CornerRadius="{StaticResource Focal.RadiusPanel}"
                Effect="{StaticResource Focal.ShadowChrome}" />

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Style="{StaticResource Focal.WindowShell}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource Focal.TitleBarHeightLength}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ════════════ 标题栏（32） ════════════ -->
                <Border Grid.Row="0"
                        Style="{StaticResource Focal.TitleBar}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <theme:FocalIcon Grid.Column="0"
                                         Icon="crop"
                                         Size="{StaticResource Focal.IconSm}"
                                         VerticalAlignment="Center"
                                         TextElement.Foreground="{StaticResource Focal.AccentBrush}" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource Focal.TitleBarText}"
                                   Text="贴图管理" />

                        <Button Grid.Column="3"
                                Style="{StaticResource Focal.WindowButtonClose}"
                                ToolTip="关闭"
                                Click="CloseWindow_Click">
                            <theme:FocalIcon Icon="x" Size="{StaticResource Focal.IconSm}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ════════════ 主体 ════════════ -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 概要行：一行字 + 右侧刷新，不要卡片、不要分隔线 -->
                    <Grid Grid.Row="0" Margin="16,16,16,0" Height="{StaticResource Focal.ControlHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryCount"
                                       Style="{StaticResource Focal.DataText}"
                                       Text="0" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="张贴图" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="·" />
                            <TextBlock x:Name="SummaryVisible"
                                       Style="{StaticResource Focal.DataText}"
                                       Text="0" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="张显示中" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="·" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="内存" />
                            <TextBlock x:Name="SummaryMemory"
                                       Style="{StaticResource Focal.DataText}"
                                       Margin="4,0,0,0"
                                       Text="0 KB" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource Focal.Button.Small}"
                                Click="Refresh_Click"
                                ToolTip="重新读取贴图列表">
                            <StackPanel Orientation="Horizontal">
                                <theme:FocalIcon Icon="save"
                                                 Size="{StaticResource Focal.IconSm}"
                                                 VerticalAlignment="Center"
                                                 TextElement.Foreground="{StaticResource Focal.OnDarkMutedBrush}" />
                                <TextBlock Margin="6,0,0,0" Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 列头：与列表行落在同一条竖线上（缩略 44 / 状态 52 / 操作 156 定宽） -->
                    <Grid Grid.Row="1" Margin="16,0,16,0" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="156" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource Focal.TextFont}"
                                   FontSize="{StaticResource Focal.MicroSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                   Text="贴图" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource Focal.TextFont}"
                                   FontSize="{StaticResource Focal.MicroSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                   Text="状态" />
                        <TextBlock Grid.Column="4"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource Focal.TextFont}"
                                   FontSize="{StaticResource Focal.MicroSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                   Text="操作" />
                    </Grid>

                    <!-- 列表区 + 空状态 -->
                    <Grid Grid.Row="2" Margin="16,4,16,0">
                        <ListBox x:Name="PinList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource PinPanelRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="156" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 缩略块 44×34 -->
                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="34"
                                                CornerRadius="{StaticResource Focal.RadiusControl}"
                                                Background="{StaticResource Focal.Obsidian700Brush}"
                                                BorderBrush="{StaticResource Focal.HairlineDarkBrush}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- 标题 14 / 元信息 12 等宽 -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Focal.BodyText}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource Focal.DataFont}"
                                                       Text="{Binding Detail}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding Detail}" />
                                        </StackPanel>

                                        <!-- 状态字：显示中用墨色，隐藏态退到 faint -->
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource Focal.CaptionSize}"
                                                   Text="{Binding StateText}"
                                                   ToolTip="{Binding StateHint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 悬停时的行内分隔（常态不画线，避免噪声） -->
                                        <Rectangle Grid.Column="3"
                                                   Width="1"
                                                   Height="18"
                                                   Fill="{StaticResource Focal.HairlineDarkBrush}"
                                                   SnapsToDevicePixels="True">
                                            <Rectangle.Style>
                                                <!-- Opacity 的默认值必须写在 Style 里：本地值会压过触发器 -->
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <!-- 单张操作：只有悬停（或选中）才出现 -->
                                        <Grid Grid.Column="4"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              x:Name="RowActions">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Style="{StaticResource Focal.Button.Small}"
                                                    Content="{Binding PinActionText}"
                                                    Tag="{Binding}"
                                                    Click="PinToFront_Click"
                                                    ToolTip="把这张贴图提到最上层" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource Focal.Button.Small}"
                                                    Content="{Binding ToggleText}"
                                                    Tag="{Binding}"
                                                    Click="PinToggleHidden_Click"
                                                    ToolTip="显示 / 隐藏这张贴图" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource Focal.Button.Small}"
                                                    Content="关闭"
                                                    Tag="{Binding}"
                                                    Click="PinClose_Click"
                                                    ToolTip="关闭这张贴图" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：人话 + 一句怎么产生贴图（显隐由 Refresh() 决定，不用会静默失效的窗口级绑定） -->
                        <StackPanel x:Name="EmptyState"
                                    Width="380"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <theme:FocalIcon Icon="brand"
                                             Size="40"
                                             HorizontalAlignment="Center"
                                             TextElement.Foreground="{StaticResource Focal.OnDarkFaintBrush}" />
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Focal.BodyText}"
                                       Text="当前没有贴图。"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="EmptyHintText"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Focal.CaptionText}"
                                       Text="把图放进剪贴板后从托盘菜单选「从剪贴板贴图」，或在截图遮罩里直接贴图。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- 批量条：一条发丝分隔 + 四个批量动作 + 关闭窗口 -->
                    <Grid Grid.Row="3" Margin="16,12,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0"
                                   Height="1"
                                   Fill="{StaticResource Focal.HairlineDarkBrush}"
                                   SnapsToDevicePixels="True" />

                        <Grid Grid.Row="1" Margin="0,12,0,0" Height="{StaticResource Focal.ControlHeightSmall}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Focal.TextFont}"
                                       FontSize="{StaticResource Focal.MicroSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Focal.OnDarkFaintBrush}"
                                       Text="批量" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource Focal.Button.Small}"
                                    Margin="0,0,4,0"
                                    Content="显示全部"
                                    Click="ShowAll_Click"
                                    ToolTip="把所有隐藏的贴图重新显示出来" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource Focal.Button.Small}"
                                    Margin="0,0,4,0"
                                    Content="隐藏全部"
                                    Click="HideAll_Click"
                                    ToolTip="全部收起，贴图仍然保留在列表里" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource Focal.Button.Small}"
                                    Margin="0,0,4,0"
                                    Content="全部置顶"
                                    Click="BringAll_Click"
                                    ToolTip="把每张贴图都提到最上层" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource Focal.Button.Small}"
                                    Content="关闭全部"
                                    Click="CloseAll_Click"
                                    ToolTip="关闭全部贴图（会同时更新备份）" />

                            <Button Grid.Column="6"
                                    Style="{StaticResource PinPanelPrimarySmall}"
                                    Content="关闭窗口"
                                    Click="CloseWindow_Click"
                                    ToolTip="只关闭这个面板，贴图不受影响" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ════════════ 状态栏（28） ════════════ -->
                <Border Grid.Row="2" Style="{StaticResource Focal.StatusBar}">
                    <Grid Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Style="{StaticResource Focal.StatusDot}"
                                 VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="可见" />
                            <TextBlock x:Name="StatusVisible"
                                       Style="{StaticResource Focal.DataCaptionText}"
                                       Margin="4,0,0,0"
                                       Text="0" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="张" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="·" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="共" />
                            <TextBlock x:Name="StatusTotal"
                                       Style="{StaticResource Focal.DataCaptionText}"
                                       Margin="4,0,0,0"
                                       Text="0" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="张" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       Margin="6,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="·" />
                            <TextBlock Style="{StaticResource Focal.CaptionText}"
                                       VerticalAlignment="Center"
                                       Text="内存" />
                            <TextBlock x:Name="StatusMemory"
                                       Style="{StaticResource Focal.DataCaptionText}"
                                       Margin="4,0,0,0"
                                       Text="0 KB" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource Focal.CaptionText}"
                                   VerticalAlignment="Center"
                                   Text="列表按层级从上到下" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

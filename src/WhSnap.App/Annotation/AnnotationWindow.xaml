<Window x:Class="WhSnap.Annotation.AnnotationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhSnap 标注"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        Background="#FF101010"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ImageRow" Height="*" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 底图 + 标注：严格 1 物理像素 = 1 像素呈现 -->
        <Canvas x:Name="CanvasArea" Grid.Row="0" ClipToBounds="True" Background="#FF101010">
            <Image x:Name="ComposedImage"
                   Canvas.Left="0"
                   Canvas.Top="0"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased" />
        </Canvas>

        <!-- 工具栏：由代码生成（工具按钮 / 调色板 / 线宽 / 撤销 / 确认） -->
        <Border Grid.Row="1"
                x:Name="ToolbarBorder"
                Background="#FF1B1B1B"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="6,5">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" />
        </Border>
    </Grid>
</Window>

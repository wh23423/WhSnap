<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      带 Windows SDK 投影的 TFM：Windows.Graphics.Capture 等 WinRT API 由 SDK 投影直接提供，
      无需额外 NuGet 包。SupportedOSPlatformVersion 与安装包的 MinVersion 保持一致（Win11）。
    -->
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WhSnap</RootNamespace>
    <AssemblyName>WhSnap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\whsnap.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-preview.1</InformationalVersion>
    <Product>WhSnap</Product>
    <Company>wh23423</Company>
    <Copyright>Copyright (c) 2026 wh23423</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Windows.Graphics.Capture 的 IGraphicsCaptureItemInterop 需要直接调虚表槽（函数指针） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WFAC010 建议把高 DPI 配置从 manifest 挪到 ApplicationHighDpiMode（WinForms 专有机制）。
      本程序是 WPF 主体 + WinForms 托盘，PerMonitorV2 必须由 manifest 声明，故有意保留。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWPF + UseWindowsForms 会让 SDK 注入 WinForms 那套隐式 using
      （System.Drawing / System.Windows.Forms，且不含 System.IO），
      造成 Rectangle、Clipboard、KeyEventArgs 等类型与 WPF 同名类型歧义。
      这里纠正为常规 BCL 集合；WinForms 类型在 TrayHost 中全限定使用。
    -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\whsnap.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DXGI Desktop Duplication / D3D11 的互操作。手写 COM 接口声明需要精确的 vtable 顺序，
      用 Vortice.Windows（MIT）的元数据生成封装更安全、可维护。
    -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhSnap.Core\WhSnap.Core.csproj" />
  </ItemGroup>

</Project>

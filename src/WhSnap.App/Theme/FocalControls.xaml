<!--
  WhSnap · Focal Design Language v1.0 · WPF 组件层
  ===========================================================================
  focal.css 的 WPF 落地：按钮两级语法 / 工具键 / 开关 / 键帽 / 输入 / 滑杆 /
  列表行 / 设置行 / 导航栏 / 横幅 / 卡片 / 菜单项 / 滚动条。
  规则：本文件只允许引用 FocalTheme.xaml 的令牌，不出现字面量色值。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="FocalTheme.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ══════════════ 焦点环：2px 琥珀描边 + 1px 外扩 ══════════════ -->
  <Style x:Key="Focal.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" RadiusX="6" RadiusY="6"
                     Stroke="{StaticResource Focal.AccentRingBrush}" StrokeThickness="2"
                     SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 按钮 · 主（唯一"决定性动作"，琥珀填充 + 墨字，CTA 不用胶囊） ══════════════ -->
  <Style x:Key="Focal.Button.Primary" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Focal.ButtonPadding}"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource Focal.AccentBrush}"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentPressBrush}"/>
              <!-- 按下 = 下沉 1px，不缩放 -->
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 按钮 · 次（暗块 + 发丝线，零阴影） ══════════════ -->
  <Style x:Key="Focal.Button.Secondary" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Focal.ButtonPadding}"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource Focal.Obsidian700Brush}"
                  BorderBrush="{StaticResource Focal.HairlineDarkBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian600Brush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 按钮 · 安静 / 危险 ══════════════ -->
  <Style x:Key="Focal.Button.Quiet" TargetType="Button" BasedOn="{StaticResource Focal.Button.Secondary}">
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focal.Button.Danger" TargetType="Button" BasedOn="{StaticResource Focal.Button.Secondary}">
    <Setter Property="Foreground" Value="{StaticResource Focal.SignalDangerBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent"
                  BorderBrush="{StaticResource Focal.HairlineDarkStrongBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.SignalDangerFillBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.SignalDangerBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 尺寸变体：主操作 34 / 小按钮 26 -->
  <Style x:Key="Focal.Button.PrimaryLarge" TargetType="Button" BasedOn="{StaticResource Focal.Button.Primary}">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeightLarge}"/>
    <Setter Property="Padding" Value="16,0,16,0"/>
  </Style>

  <Style x:Key="Focal.Button.Small" TargetType="Button" BasedOn="{StaticResource Focal.Button.Secondary}">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeightSmall}"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
  </Style>

  <Style x:Key="Focal.Button.Icon" TargetType="Button" BasedOn="{StaticResource Focal.Button.Quiet}">
    <Setter Property="Width" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- ══════════════ 工具键（30×30，选中 = 琥珀填充 + 墨色图标） ══════════════ -->
  <Style x:Key="Focal.Tool" TargetType="ToggleButton">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentHoverBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 带标签的工具键：inline-flex + nowrap（不要用 grid 的 auto 列，收缩时会折行） -->
  <Style x:Key="Focal.ToolWide" TargetType="ToggleButton" BasedOn="{StaticResource Focal.Tool}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentHoverBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 分段控制（24 高，选中 = 琥珀） ══════════════ -->
  <Style x:Key="Focal.Segment" TargetType="ToggleButton">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian600Brush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 开关（34×18 凹槽 + 12 圆点；关闭态是凹槽不是灰色按钮） ══════════════ -->
  <Style x:Key="Focal.Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="34" Height="18">
            <Border x:Name="Track" Background="{StaticResource Focal.Obsidian600Brush}"
                    BorderBrush="{StaticResource Focal.HairlineDarkStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Focal.RadiusFull}"/>
            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{StaticResource Focal.OnDarkMutedBrush}"
                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Focal.AccentInkBrush}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 复选框（勾是几何图形，不是字体符号） ══════════════ -->
  <Style x:Key="Focal.Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center"
                    Background="{StaticResource Focal.Obsidian900Brush}"
                    BorderBrush="{StaticResource Focal.HairlineDarkStrongBrush}" BorderThickness="1"
                    CornerRadius="4" SnapsToDevicePixels="True">
              <Path x:Name="Tick" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                    Fill="{StaticResource Focal.AccentInkBrush}"
                    Data="M 14,47 L 0,61 L 38,100 L 100,22 L 86,8 L 36,71 Z"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
              <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 输入框（凹陷表面：obsidian-900 + 发丝线；聚焦换琥珀描边） ══════════════ -->
  <Style x:Key="Focal.Input" TargetType="TextBox">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="Padding" Value="12,0,12,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Focal.AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Focal.AccentBrush}"/>
    <Setter Property="SelectionOpacity" Value="0.35"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{StaticResource Focal.Obsidian900Brush}"
                  BorderBrush="{StaticResource Focal.HairlineDarkBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 数值输入：等宽 + 表格数字 -->
  <Style x:Key="Focal.InputData" TargetType="TextBox" BasedOn="{StaticResource Focal.Input}">
    <Setter Property="FontFamily" Value="{StaticResource Focal.DataFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.DataSize}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>

  <!-- ══════════════ 下拉选择（手绘箭头，避免各系统箭头不一致） ══════════════ -->
  <Style x:Key="Focal.Select" TargetType="ComboBox">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="{StaticResource Focal.Obsidian900Brush}"
                          BorderBrush="{StaticResource Focal.HairlineDarkBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource Focal.RadiusControl}" SnapsToDevicePixels="True">
                    <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                          Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource Focal.OnDarkMutedBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Cp" Margin="12,0,30,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade"
                   MinWidth="{TemplateBinding ActualWidth}">
              <Border Background="{StaticResource Focal.Obsidian800Brush}"
                      BorderBrush="{StaticResource Focal.HairlineDarkStrongBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Focal.RadiusControl}" Padding="4" Margin="0,4,0,0"
                      Effect="{StaticResource Focal.ShadowChrome}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focal.SelectItem" TargetType="ComboBoxItem">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentTintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 滑杆（轨道 3px、握把 14px，琥珀只在握把） ══════════════ -->
  <Style x:Key="Focal.Slider" TargetType="Slider">
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="3" CornerRadius="2" Background="{StaticResource Focal.Obsidian600Brush}"
                    VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource Focal.AccentBrush}"
                               Stroke="{StaticResource Focal.Obsidian900Brush}" StrokeThickness="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 滚动条（10px，全圆拇指；轨道透明） ══════════════ -->
  <Style x:Key="Focal.ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="{StaticResource Focal.HairlineDarkStrongBrush}"
                  CornerRadius="{StaticResource Focal.RadiusFull}" Margin="3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.OnDarkFaintBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focal.ScrollBar" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Focal.ScrollThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 卡片 / 胶囊 / 分隔线 / 横幅 ══════════════ -->
  <Style x:Key="Focal.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian800Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Focal.RadiusCard}"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.Chip" TargetType="Border">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Focal.RadiusFull}"/>
  </Style>

  <Style x:Key="Focal.ChipAccent" TargetType="Border" BasedOn="{StaticResource Focal.Chip}">
    <Setter Property="Background" Value="{StaticResource Focal.AccentTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.AccentBorderBrush}"/>
  </Style>

  <!-- 垂直发丝分隔（工具条分组） -->
  <Style x:Key="Focal.DividerV" TargetType="Rectangle">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Fill" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="Margin" Value="6,0,6,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.DividerH" TargetType="Rectangle">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Fill" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 横幅：语义色只出现在状态面（图标颜色由使用方按变体给出） -->
  <Style x:Key="Focal.Banner" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Focal.RadiusCard}"/>
    <Setter Property="Padding" Value="16,12,16,12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.BannerWarn" TargetType="Border" BasedOn="{StaticResource Focal.Banner}">
    <Setter Property="Background" Value="{StaticResource Focal.SignalWarnFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.AccentBorderBrush}"/>
  </Style>

  <Style x:Key="Focal.BannerDanger" TargetType="Border" BasedOn="{StaticResource Focal.Banner}">
    <Setter Property="Background" Value="{StaticResource Focal.SignalDangerFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.SignalDangerBorderBrush}"/>
  </Style>

  <Style x:Key="Focal.BannerOk" TargetType="Border" BasedOn="{StaticResource Focal.Banner}">
    <Setter Property="Background" Value="{StaticResource Focal.SignalOkFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.SignalOkBorderBrush}"/>
  </Style>

  <!-- ══════════════ 窗口机壳 · 标题栏 · 状态栏 ══════════════ -->
  <Style x:Key="Focal.WindowShell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian900Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Focal.RadiusPanel}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.TitleBar" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Focal.TitleBarHeight}"/>
    <Setter Property="Background" Value="{StaticResource Focal.VoidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.TitleBarText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- 窗口按钮：Windows 11 语汇，但只有墨色描线（没有红黄绿三色圆点） -->
  <Style x:Key="Focal.WindowButton" TargetType="Button">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Focal.RadiusHair}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focal.WindowButtonClose" TargetType="Button" BasedOn="{StaticResource Focal.WindowButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Focal.RadiusHair}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.SignalDangerBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.PaperBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focal.StatusBar" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Focal.StatusBarHeight}"/>
    <Setter Property="Background" Value="{StaticResource Focal.VoidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Fill" Value="{StaticResource Focal.SignalOkBrush}"/>
  </Style>

  <!-- ══════════════ 导航栏（设置 / 标注左侧） ══════════════ -->
  <Style x:Key="Focal.Rail" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource Focal.RailWidth}"/>
    <Setter Property="Background" Value="{StaticResource Focal.VoidBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.RailItem" TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="Margin" Value="8,1,8,1"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Focal.RadiusControl}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentTintBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 列表行（悬停才出操作；选中用 accent-tint，不加粗边框） ══════════════ -->
  <Style x:Key="Focal.ListItem" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource Focal.RowHeightLarge}"/>
    <Setter Property="Padding" Value="12,8,12,8"/>
    <Setter Property="Margin" Value="0,1,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusCard}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.Obsidian700Brush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentTintBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.AccentBorderBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 设置行：标题 + 一句人话 + 控件 ══════════════ -->
  <Style x:Key="Focal.Row" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="{StaticResource Focal.RowPadding}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Focal.RowLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Focal.RowHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>

  <!-- ══════════════ 键位录制按钮（录制态 1.2s 脉冲，是唯一允许的循环动画） ══════════════ -->
  <Style x:Key="Focal.KeycapButton" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="104"/>
    <Setter Property="Height" Value="{StaticResource Focal.ControlHeight}"/>
    <Setter Property="Padding" Value="12,0,12,0"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.DataFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.DataSize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{StaticResource Focal.Obsidian900Brush}"
                  BorderBrush="{StaticResource Focal.HairlineDarkBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Focal.RadiusControl}" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
            </Trigger>
            <!-- 录制中：琥珀边界 + 琥珀字 + 1.2s 透明度脉冲 -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentTintBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentBrush}"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="RecordingPulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.55" Duration="0:0:0.6"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="RecordingPulse"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Tag" Value="conflict">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focal.SignalDangerBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.SignalDangerFillBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.SignalDangerBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 色板（色块是圆角方块；选中用琥珀外环而不是加粗边框） ══════════════ -->
  <Style x:Key="Focal.Swatch" TargetType="ToggleButton">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focal.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Ring" Width="28" Height="28" CornerRadius="8"
                    BorderBrush="Transparent" BorderThickness="2" Background="Transparent"/>
            <Border x:Name="Chip" Width="22" Height="22" CornerRadius="{StaticResource Focal.RadiusControl}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Focal.HairlineDarkStrongBrush}" BorderThickness="1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Focal.AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 菜单项（托盘右键 / 自绘菜单共用视觉） ══════════════ -->
  <Style x:Key="Focal.MenuItem" TargetType="Button">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="8,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Focal.RadiusControl}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Focal.AccentBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource Focal.AccentInkBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="danger">
              <Setter Property="Foreground" Value="{StaticResource Focal.SignalDangerBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 提示气泡 ══════════════ -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian800Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Focal.HairlineDarkStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5,8,5"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.CaptionSize}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Focal.RadiusControl}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ 隐式样式：界面默认就是这套语言 ══════════════ -->
  <!--
    隐式文本样式**不写死前景色**：文字要继承最近控件的 Foreground，
    否则"琥珀填充 + 墨字"的选中态会被一个白色文字毁掉（对比度 1.5:1）。
    最近祖先控件取不到前景色时（极少见）回落 OnDark。
  -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="{StaticResource Focal.BodyLineHeight}"/>
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Control}"
                 FallbackValue="{StaticResource Focal.OnDarkBrush}"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 窗口默认：暗色机壳 + 暗底文字（界面代码不必每个窗口重复声明） -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Focal.Obsidian900Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource Focal.TextFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Focal.BodySize}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Focal.Button.Secondary}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource Focal.Check}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource Focal.Input}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Focal.Select}"/>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Focal.SelectItem}"/>
  <Style TargetType="Slider" BasedOn="{StaticResource Focal.Slider}"/>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource Focal.ScrollBar}"/>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Focal.ListItem}"/>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Focal.OnDarkBrush}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

</ResourceDictionary>
